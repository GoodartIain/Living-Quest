# Copy to .env and change both values. The secret must be at least 32 characters.
LIVEKIT_API_KEY=livingquest
LIVEKIT_API_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# For other machines: the public WSS address of LiveKit, and this server's public IP.
# LIVEKIT_PUBLIC_URL=wss://voice.example.com
# LIVEKIT_NODE_IP=203.0.113.10
