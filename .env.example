# Copy to .env and fill in every value marked CHANGE. Never commit .env.

# Your public addresses. Caddy gets HTTPS certificates for them automatically (DNS must point here, ports 80/443 open).
APP_DOMAIN=quest.example.com
VOICE_DOMAIN=voice.example.com
# Let's Encrypt account email (certificate expiry notices).
ACME_EMAIL=you@example.com

# CHANGE: database password (the database is only reachable inside the compose network).
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# CHANGE: LiveKit (voice/video). The secret must be at least 32 characters.
LIVEKIT_API_KEY=livingquest
LIVEKIT_API_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# CHANGE: this server's public IP (where browsers send call media).
LIVEKIT_NODE_IP=203.0.113.10

# Optional
# DEV_SIGNIN=1                # allow name-only sign-in (never on a public server)
# RATE_LIMIT_PER_MINUTE=600   # API requests per address per minute
# SIGNUPS_PER_HOUR=20         # new accounts per address per hour
# BACKUP_KEEP_DAYS=14         # how many days of daily backups the backup service keeps
